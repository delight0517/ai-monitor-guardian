;
; AiDebugGuestDisplay.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=AiDebugGuestDisplay.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=MyDevice_Install, Root\AiDebugGuestDisplay ; TODO: edit hw-id, this hardware id is used by Visual Studio remote debugging
; Software-device install ID omitted; this guest-only package supports the dedicated root hardware ID only.

[SourceDisksFiles]
AiDebugGuestDisplay.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "AiDebugGuestDisplayGroup" ; TODO: edit driver group name, see README.md for more info

[MyDevice_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MyDevice_Install.NT.Wdf]
UmdfService=AiDebugGuestDisplay,AiDebugGuestDisplay_Install
UmdfServiceOrder=AiDebugGuestDisplay
UmdfKernelModeClientPolicy = AllowKernelModeClients

[AiDebugGuestDisplay_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\AiDebugGuestDisplay.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
AiDebugGuestDisplay.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="AI Debug Display Prototype (guest only)"
DiskName = "AI Debug Guest Display (guest only)"
DeviceName="AI Debug Guest Display"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
